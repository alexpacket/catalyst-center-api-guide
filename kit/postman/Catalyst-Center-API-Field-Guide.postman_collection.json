{
  "info": {
    "name": "Catalyst Center API field guide",
    "description": "Companion collection for the CiscoSE Catalyst Center API field guide (https://catc-api.ciscose.com). Baseline: Catalyst Center 3.2.3. Read-only calls plus one Command Runner job. Most writes are asynchronous: they return a taskId that you poll with GET /tasks/{id}. Rate limits are per operation and counted per client IP address. Confirm every operation in Platform > Developer Toolkit > APIs on your release.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fetch a token when none is cached or it is older than 55 minutes (the API reference gives a 60-minute lifetime).",
          "const exp = Number(pm.collectionVariables.get('tokenExp') || 0);",
          "if (pm.request.url.getPath().endsWith('/auth/token') || (pm.collectionVariables.get('token') && Date.now() < exp)) return;",
          "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/dna/system/api/v1/auth/token', method: 'POST',",
          "  header: { Authorization: 'Basic ' + btoa(pm.environment.get('username') + ':' + pm.environment.get('password')) } }, (err, res) => {",
          "  if (err || res.code !== 200) { console.error('Login failed', err || res.code); return; }",
          "  pm.collectionVariables.set('token', res.json().Token); pm.collectionVariables.set('tokenExp', Date.now() + 55 * 60 * 1000); });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenExp",
      "value": "0"
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Authentication",
      "item": [
        {
          "name": "Get token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/dna/system/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "system",
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "description": "Basic auth in, X-Auth-Token out. The collection's pre-request script also does this automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().Token);",
                  "pm.collectionVariables.set('tokenExp', Date.now() + 55*60*1000);"
                ]
              }
            }
          ]
        }
      ]
    },
