    {
      "name": "5 Command Runner (reaches the device)",
      "item": [
        {
          "name": "Find a reachable switch",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Auth-Token",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dna/intent/api/v1/network-device?family=Switches and Hubs&reachabilityStatus=Reachable&offset=1&limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "intent",
                "api",
                "v1",
                "network-device"
              ],
              "query": [
                {
                  "key": "family",
                  "value": "Switches and Hubs"
                },
                {
                  "key": "reachabilityStatus",
                  "value": "Reachable"
                },
                {
                  "key": "offset",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": "Stores deviceId for the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().response || []; if (r.length) pm.collectionVariables.set('deviceId', r[0].id);",
                  "pm.test('found a reachable switch', () => pm.expect(r.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run show commands",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Auth-Token",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dna/intent/api/v1/network-device-poller/cli/read-request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "intent",
                "api",
                "v1",
                "network-device-poller",
                "cli",
                "read-request"
              ],
              "query": []
            },
            "description": "Read-only commands (allowed keywords: GET /network-device-poller/cli/legit-reads). Returns a taskId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commands\": [\n    \"show version\"\n  ],\n  \"deviceUuids\": [\n    \"{{deviceId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.response && j.response.taskId) { pm.collectionVariables.set('taskId', j.response.taskId); }",
                  "pm.test('accepted with a taskId', () => { pm.expect(pm.response.code).to.be.oneOf([200, 202]); pm.expect(j.response.taskId).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll task",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Auth-Token",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dna/intent/api/v1/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "intent",
                "api",
                "v1",
                "tasks",
                "{{taskId}}"
              ],
              "query": []
            },
            "description": "Send until status is SUCCESS or FAILURE. /task/{taskId} is Sunset since 2.3.7.6."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().response || {};",
                  "pm.test('task finished: send again while status is PENDING', () => pm.expect(t.status).to.be.oneOf(['SUCCESS', 'FAILURE']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Task detail (fileId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Auth-Token",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dna/intent/api/v1/tasks/{{taskId}}/detail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "intent",
                "api",
                "v1",
                "tasks",
                "{{taskId}}",
                "detail"
              ],
              "query": []
            },
            "description": "progress should hold the output fileId; failureReason explains a failure. If the fileId test fails, send the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('fileId');",
                  "const d = pm.response.json().response || {};",
                  "try { pm.collectionVariables.set('fileId', JSON.parse(d.progress).fileId); } catch (e) { console.log('No fileId in detail progress', d.failureReason || ''); }",
                  "pm.test('progress holds a fileId (else use the legacy task request)', () => pm.expect(pm.collectionVariables.get('fileId')).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Legacy task (fileId fallback)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Auth-Token",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dna/intent/api/v1/task/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "intent",
                "api",
                "v1",
                "task",
                "{{taskId}}"
              ],
              "query": []
            },
            "description": "Sunset since 2.3.7.6 but still answering. Cisco's Command Runner guide reads the fileId from this response's progress field."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().response || {};",
                  "try { pm.collectionVariables.set('fileId', JSON.parse(d.progress).fileId); } catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Fetch output file",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Auth-Token",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dna/intent/api/v1/file/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dna",
                "intent",
                "api",
                "v1",
                "file",
                "{{fileId}}"
              ],
              "query": []
            },
            "description": ""
          }
        }
      ]
    }
  ]
